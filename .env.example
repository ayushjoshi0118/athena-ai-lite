# Athena AI Lite - Environment Configuration Template
# Copy this file to .env and fill in your values if using live API services.
# If keys are omitted, Athena AI Lite gracefully activates labeled Mock Mode.

# --- LLM Provider Settings (Google Gemini) ---
# Obtain from: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Web Search Provider Settings ---
# Supported providers: "duckduckgo" (free, no key required), "tavily" (requires key), or "mock"
WEB_SEARCH_PROVIDER=duckduckgo
TAVILY_API_KEY=

# --- Embeddings Settings ---
# Local sentence-transformers model (downloads automatically on first run)
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# --- RAG Settings ---
DEFAULT_TOP_K=4
DEFAULT_CHUNK_SIZE=500
DEFAULT_CHUNK_OVERLAP=50
